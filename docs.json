{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "styling": {
    "latex": false
  },
  "appearance": {
    "default": "system"
  },
  "name": "Betacms",
  "description": "Create, manage, and publish dynamic content",
  "colors": {
    "primary": "#000",
    "light": "#fff",
    "dark": "#000"
  },
  "favicon": "./logo/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "compass",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "overview",
              "getting-started"
            ]
          },
          {
            "group": "Content model",
            "pages": [
              "features/projects-guide",
              "features/collections-guide",
              "features/fields-guide",
              "features/items-guide"
            ]
          },
          {
            "group": "Automate",
            "pages": [
              "integrate/webhooks/project-webhooks",
              "integrate/webhooks/convex-events"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "logo": {
    "light": "./logo/light.png",
    "dark": "./logo/dark.png",
    "href": "https://betacms.rathon.agency"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Betacms",
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "keywords": "Betacms, Cms"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Help",
        "href": "/help"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://betacms.rathon.agency"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}